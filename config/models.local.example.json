{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "mylocal": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "api": "openai-completions",
      "apiKey": "${MYLOCAL_API_KEY}",
      "models": [
        {
          "id": "<model-id>",
          "name": "<Model> (mylocal)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "promptCache": { "short": 3600 }
        }
      ]
    }
  }
}
